<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      erp-biz-sales：销售管理(销售订单/销售出库/销售退货/价格策略)
      分层约定: entity / mapper / service / service.impl / controller / dto
    -->
    <parent>
        <groupId>com.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>erp-biz-sales</artifactId>
    <name>erp-biz-sales</name>
    <description>销售管理(销售订单/销售出库/销售退货/价格策略)</description>

    <dependencies>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-framework</artifactId>
        </dependency>
        <!-- @OperLog 操作日志注解（切面在 erp-platform-system，bootstrap 统一装配） -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-platform-system</artifactId>
        </dependency>
        <!-- 依赖基础资料模块(物料/仓库等公共主数据) -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-basedata</artifactId>
        </dependency>
        <!-- 跨模块业务接线(依赖方向单向: sales -> {inventory,cost,workflow})：
             出库/退货走 StockService(批次感知)、出库实际成本走 CostService、
             订单审核接审批流 WorkflowService -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-cost</artifactId>
        </dependency>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-platform-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
