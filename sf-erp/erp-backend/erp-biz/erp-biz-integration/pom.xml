<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      erp-biz-integration：ERP↔MES 集成（ERP 侧）
      契约唯一事实源：sf-mes/docs/MES与ERP协同设计.md（六类接口 + outbox/幂等/对账）。
      出站：生产订单下达事件下推 + 物料/BOM/工艺路线主数据每日全量对账推送（int_outbox + 指数退避重试）；
      入站：完工报工/领料/退料/质检结果/工单进度镜像（/integration/mes/**，X-Integration-Token 鉴权）。
    -->
    <parent>
        <groupId>com.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>erp-biz-integration</artifactId>
    <name>erp-biz-integration</name>
    <description>ERP-MES 集成（下推/回传/outbox 重试/入站幂等）</description>

    <dependencies>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-framework</artifactId>
        </dependency>
        <!-- @OperLog 操作日志注解（切面在 erp-platform-system，bootstrap 统一装配） -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-platform-system</artifactId>
        </dependency>
        <!-- 主数据映射（物料/仓库/单位/类别编码查询） -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-basedata</artifactId>
        </dependency>
        <!-- 入站回传走 StockService 统一库存入口 + 出站生产订单/主数据源表在 mrp -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-mrp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
