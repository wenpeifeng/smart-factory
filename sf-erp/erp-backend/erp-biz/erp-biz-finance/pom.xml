<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      erp-biz-finance：财务管理(应收应付/收付款/总账凭证/期末结账)
      分层约定: entity / mapper / service / service.impl / controller / dto
    -->
    <parent>
        <groupId>com.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>erp-biz-finance</artifactId>
    <name>erp-biz-finance</name>
    <description>财务管理(应收应付/收付款/总账凭证/期末结账)</description>

    <dependencies>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-framework</artifactId>
        </dependency>
        <!-- @OperLog 操作日志注解（切面在 erp-platform-system，bootstrap 统一装配） -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-platform-system</artifactId>
        </dependency>
        <!-- 依赖基础资料模块(物料/仓库等公共主数据) -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-basedata</artifactId>
        </dependency>
        <!-- 跨模块业务接线(依赖方向单向: finance -> budget，budget 仅依赖
             framework+basedata 不反向依赖 finance，无循环)：付款单创建时
             BudgetControlService.check 预算占用校验(BLOCK 拒绝/WARN 备注放行)、
             核销成功后 record 登记预算执行数 -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-biz-budget</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
